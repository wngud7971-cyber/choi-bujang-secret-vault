{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -- --agent-web",
  "outputDirectory": "web-build",
  "rewrites": [
    { "source": "/api/operations", "destination": "/api/ai?__byteback_route=operations" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
